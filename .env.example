# Copy to .env and fill in. Never commit .env.

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=vfo_user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=voyage_flow_ops

# Long random string used to sign login tokens (generate e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string

# Exposed to the browser (VITE_ prefix). Not secret.
VITE_APP_NAME=InTravelSync
